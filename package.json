{
	"name": "calculator",
	"version": "1.0.0",
	"homepage": "https://ValeriaKliui.github.io/calculator",
	"scripts": {
		"dev": "webpack serve --env port=3000",
		"build": "webpack --env mode=production",
		"lint": "npx eslint . --fix",
		"predeploy": "npm run build",
		"deploy": "gh-pages -d dist",
		"prepare": "husky",
		"test": "jest"
	},
	"jest": {
		"transform": {
			"^.+\\.jsx?$": "babel-jest"
		},
		"testEnvironment": "jsdom",
		"setupFilesAfterEnv": [
			"<rootDir>/src/tests/setup.js"
		]
	},
	"lint-staged": {
		"**/*": "prettier --write --ignore-unknown"
	},
	"devDependencies": {
		"@babel/preset-env": "^7.26.7",
		"@eslint/js": "^9.17.0",
		"babel-jest": "^29.7.0",
		"css-loader": "^7.1.2",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-jest": "^28.11.0",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"gh-pages": "^6.2.0",
		"globals": "^15.14.0",
		"html-webpack-plugin": "^5.6.3",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"lint-staged": "^15.4.2",
		"normalize-scss": "^8.0.0",
		"prettier": "3.4.2",
		"sass": "^1.83.0",
		"sass-loader": "^16.0.4",
		"style-loader": "^4.0.0",
		"webpack": "^5.97.1",
		"webpack-cli": "^6.0.1",
		"webpack-dev-server": "^5.2.0"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": ""
}
